# XSIGHT Backend Environment
# Copy to `.env` and fill in your values. `.env` is gitignored.

# =============================================================
# CHAT PROVIDER
# Pick one: zen | local
#   zen   = OpenCode Zen (cloud)
#   local = OpenAI-compatible gateway you run on this machine
# =============================================================
CHAT_PROVIDER=local

# --- Option A: OpenCode Zen (cloud) --------------------------
# Get your key at https://opencode.ai/auth
ZEN_API_KEY=

# Speed/quality picks (paid, zero-retention):
#   gemini-3-flash       (default — fastest, ~1s, $0.50/$3.00 per 1M)
#   gpt-5-nano           ($0.05/$0.40 per 1M, very cheap, very fast)
#   claude-haiku-4-5     (clean clinical tone, $1/$5 per 1M)
ZEN_MODEL=gemini-3-flash
ZEN_BASE_URL=https://opencode.ai/zen/v1


# --- Option B: Local OpenAI-compatible gateway ---------------
# e.g. an "AI router" running on your laptop.
LOCAL_BASE_URL=http://localhost:20128/v1
LOCAL_API_KEY=
# Recommended default: gh/gpt-4o-mini (fastest, cheap, multimodal-friendly)
# Other good picks: gh/gpt-4o, gh/claude-haiku-4.5, ag/gemini-3-flash
LOCAL_CHAT_MODEL=gh/gpt-4o-mini


# =============================================================
# VISION PROVIDER
# Pick one: local | zen | gemini | ollama | mock
# Auto-falls back through the chain on auth/connection errors:
#   local -> zen -> gemini -> ollama -> mock
# =============================================================
VISION_PROVIDER=local

# --- Option 1: Local OpenAI-compatible gateway ---------------
# Reuses LOCAL_BASE_URL + LOCAL_API_KEY from above.
# Recommended: gh/gpt-4o (verified vision support)
LOCAL_VISION_MODEL=gh/gpt-4o

# --- Option 2: OpenCode Zen ----------------------------------
ZEN_VISION_MODEL=gemini-3-flash

# --- Option 3: Google Gemini Free Tier (cloud, free) ---------
# Get a free key: https://aistudio.google.com/app/apikey
# Free tier on flash models is generous (15 RPM / 1M tokens/day).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Option 4: Ollama (free, runs on your laptop) ------------
# Install:  curl -fsSL https://ollama.com/install.sh | sh
#
# Recommended models (best speed/quality on a laptop):
#   ollama pull qwen2.5vl:3b   (~3GB, ~1-2s/frame, BEST default)
#   ollama pull minicpm-v:8b   (~5GB, very strong object/scene ID)
#   ollama pull moondream      (~1.7GB, smallest but often hallucinates)
#   ollama pull llava:7b       (~4.7GB, balanced)
#
# Run:  ollama serve  (defaults to :11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Keep the model loaded forever for fastest demo responses.
OLLAMA_KEEP_ALIVE=-1

# Generation tuning. Smaller = faster, longer = more detail.
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_PREDICT=80
# 0 = auto-detect. Set NUM_GPU=999 to force full GPU offload.
OLLAMA_NUM_GPU=0
OLLAMA_NUM_THREAD=0


# =============================================================
# SERVER
# =============================================================
XSIGHT_HOST=0.0.0.0
XSIGHT_PORT=8000
XSIGHT_RELOAD=0

# Comma-separated exact origins. Use "*" only for local dev.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.2.2
# Regex allows Flutter/web dev ports on localhost/emulator.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.0\.2\.2)(:\d+)?$

# Basic in-memory per-IP rate limit for HTTP endpoints.
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Required for /debug/* endpoints. Empty disables debug endpoints.
DEBUG_API_KEY=

# Request caps.
MAX_CHAT_MESSAGES=50
MAX_MESSAGE_LENGTH=4000
MAX_IMAGE_B64_LENGTH=10485760
MAX_UPLOAD_BYTES=10485760
# /tts is unauthenticated and synthesis is CPU/GPU-bound; cap the input so one
# caller can't monopolize the engine.
MAX_TTS_TEXT_LENGTH=2000

# Local chest X-ray classifier (server/ml/xray/). Below this softmax
# probability, /xray reports label "other" (Inconclusive) instead of a
# confident-looking wrong prediction. See XRAY_TRAINING.md §7.
XRAY_LOW_CONF_THRESHOLD=0.55
# XRAY_ARCH=efficientnet_b0
# XRAY_DEVICE=auto

# =============================================================
# DEBUGGING
# =============================================================
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Set to 1 to log full AI request/response payloads (verbose).
LOG_AI_PAYLOAD=0
# Per-request timeout for vision providers in seconds (Ollama can be slow on CPU).
VISION_TIMEOUT=120

# =============================================================
# REALTIME VOICE PIPELINE  (/ws/voice)
# Optional. Install with:
#     pip install -r requirements-voice.txt
# Then place these two files in server/:
#     kokoro-v0_19.onnx
#     voices.bin
# Download from https://huggingface.co/hexgrad/Kokoro-82M
# =============================================================
VOICE_STT_MODEL=small         # tiny | base | small | medium
VOICE_STT_DEVICE=auto         # cpu | cuda | auto
VOICE_STT_COMPUTE=int8
VOICE_STT_LANG=en

# TTS Provider: kokoro | mms | deepgram
VOICE_TTS_PROVIDER=mms
KOKORO_MODEL=kokoro-v0_19.onnx
KOKORO_VOICES=voices.bin
KOKORO_VOICE=af_sky
# Meta MMS-TTS (Hugging Face) — Tagalog: facebook/mms-tts-tgl | English: facebook/mms-tts-eng
MMS_MODEL_ID=facebook/mms-tts-tgl
# Deepgram Aura TTS. Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
VOICE_TTS_SR=24000

VOICE_VAD_AGGR=2
VOICE_END_SILENCE_MS=500
VOICE_MIN_SPEECH_MS=250
VOICE_MAX_SPEECH_MS=8000
VOICE_POST_TTS_COOLDOWN_MS=350
# When the user asks a visual question ("what do you see"), wait up to
# this many ms for the client to send back a vision_context event before
# we call /chat.
VOICE_VISION_WAIT_MS=6000
# How long a cached vision_context stays "fresh" (skip waiting / reuse).
VOICE_VISION_TTL_MS=15000
